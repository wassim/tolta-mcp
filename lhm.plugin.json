    {
      "name": "list_applications",
      "title": "List applications",
      "description": "The member's applications, most recently updated first, with their status and whether one is waiting on the member.",
      "inputSchema": {
        "properties": {
          "limit": {
            "description": "How many to list, 20 by default.",
            "minimum": 1,
            "maximum": 50,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "properties": {
          "applications": {
            "description": "Most recently updated first.",
            "items": {
              "properties": {
                "application_id": {
                  "description": "The application's id, for get_application.",
                  "type": "string"
                },
                "job_id": {
                  "description": "The job's id, for get_job.",
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "company": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "drafting",
                    "needs_you",
                    "submitting",
                    "failed",
                    "applied",
                    "screening",
                    "interviewing",
                    "offer",
                    "rejected",
                    "withdrawn",
                    "no_response",
                    "accepted"
                  ],
                  "type": "string"
                },
                "waiting_on_you": {
                  "description": "True while a question waits for the member's answer in Tolta.",
                  "type": "boolean"
                },
                "updated_at": {
                  "description": "ISO 8601.",
                  "type": "string"
                },
                "open_in_tolta": {
                  "description": "The application's page in Tolta, the only link to give the member.",
                  "type": "string"
                }
              },
              "type": "object",
              "required": [
                "application_id",
                "job_id",
                "title",
                "company",
                "status",
                "waiting_on_you",
                "updated_at",
                "open_in_tolta"
              ]
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "applications"
        ]
      }
