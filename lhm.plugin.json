    {
      "name": "search_jobs",
      "title": "Search open jobs",
      "description": "Searches the open jobs on Tolta, 20 a page, in the member's country or open to anywhere; set other_countries to include roles tied to other countries. Without a query, jobs are ranked by how close they are to the member's profile. Sorted by relevance, a query is matched by keywords and by meaning, so plain sentences work, results may not contain every word, and total is null because every job gets ranked. Sorted by newest, a query needs every word. One search reaches its top 500 results; add a keyword or a filter to see others.",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "Keywords such as a job title, skill or company name.",
            "type": "string"
          },
          "remote": {
            "description": "Only jobs with one of these remote arrangements.",
            "items": {
              "enum": [
                "remote",
                "hybrid",
                "onsite"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "seniority": {
            "description": "Only jobs at one of these levels.",
            "items": {
              "enum": [
                "intern",
                "junior",
                "mid",
                "senior",
                "lead",
                "principal",
                "executive"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "job_family": {
            "description": "Only jobs in one of these fields of work.",
            "items": {
              "enum": [
                "engineering",
                "data_ai",
                "product",
                "design",
                "it_support",
                "security",
                "sales",
                "marketing",
                "customer",
                "operations",
                "finance",
                "legal",
                "people",
                "healthcare",
                "culinary_hospitality",
                "retail",
                "fitness_wellness",
                "education",
                "supply_chain",
                "manufacturing_trades",
                "facilities",
                "administrative",
                "research_science",
                "consulting",
                "executive"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "salary_min": {
            "description": "Minimum yearly salary.",
            "minimum": 0,
            "type": "integer"
          },
          "posted_within_days": {
            "description": "Only jobs posted in the last day, week or month.",
            "enum": [
              1,
              7,
              30
            ],
            "type": "integer"
          },
          "other_countries": {
            "description": "Include roles tied to other countries, for a member looking abroad.",
            "type": "boolean"
          },
          "sort": {
            "description": "relevance by default.",
            "enum": [
              "relevance",
              "newest"
            ],
            "type": "string"
          },
          "page": {
            "description": "The page of results, from 1.",
            "minimum": 1,
            "maximum": 25,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "properties": {
          "total": {
            "description": "How many jobs match; null when sorted by relevance with a query.",
            "type": [
              "integer",
              "null"
            ]
          },
          "page": {
            "type": "integer"
          },
          "has_more": {
            "description": "True when the next page has more jobs.",
            "type": "boolean"
          },
          "jobs": {
            "items": {
              "properties": {
                "job_id": {
                  "description": "The job's id, for get_job.",
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "company": {
                  "type": "string"
                },
                "location": {
                  "description": "Where the role is based, as the posting says.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "remote": {
                  "description": "How remote the role is, when the posting says.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "seniority": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "salary": {
                  "description": "Null when the posting gives no salary.",
                  "properties": {
                    "min": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "max": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "currency": {
                      "description": "ISO 4217 code.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "period": {
                      "description": "What the amounts are paid per, such as year or hour.",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "min",
                    "max",
                    "currency",
                    "period"
                  ]
                },
                "posted_on": {
                  "description": "ISO date.",
                  "type": "string"
                },
                "fit_score": {
                  "description": "How well the job fits the member, out of 100.",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "fit_reasons": {
                  "items": {
                    "properties": {
                      "text": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "positive": {
                        "description": "False for a reason the job fits less well.",
                        "type": "boolean"
                      }
                    },
                    "type": "object",
                    "required": [
                      "text",
                      "positive"
                    ]
                  },
                  "type": "array"
                },
                "open_in_tolta": {
                  "description": "The job's page in Tolta, the only link to give the member.",
                  "type": "string"
                }
              },
              "type": "object",
              "required": [
                "job_id",
                "title",
                "company",
                "location",
                "remote",
                "seniority",
                "salary",
                "posted_on",
                "fit_score",
                "fit_reasons",
                "open_in_tolta"
              ]
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "total",
          "page",
          "has_more",
          "jobs"
        ]
      }
    },
