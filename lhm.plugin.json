  "tools": [
    {
      "name": "todays_matches",
      "title": "Today's job matches",
      "description": "Today's job matches for the member, best first: the same matches the Tolta dashboard shows today. Each has a match_id, the job, a fit score out of 100 and the reasons for it.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "properties": {
          "matches": {
            "description": "Best first; empty when there are no new matches today.",
            "items": {
              "properties": {
                "match_id": {
                  "description": "The match's id, for apply_to_match.",
                  "type": "string"
                },
                "job_id": {
                  "description": "The job's id, for get_job.",
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "company": {
                  "type": "string"
                },
                "location": {
                  "description": "Where the role is based, as the posting says.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "remote": {
                  "description": "How remote the role is, when the posting says.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "seniority": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "salary": {
                  "description": "Null when the posting gives no salary.",
                  "properties": {
                    "min": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "max": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "currency": {
                      "description": "ISO 4217 code.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "period": {
                      "description": "What the amounts are paid per, such as year or hour.",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "min",
                    "max",
                    "currency",
                    "period"
                  ]
                },
                "posted_on": {
                  "description": "ISO date.",
                  "type": "string"
                },
                "fit_score": {
                  "description": "How well the job fits the member, out of 100.",
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "fit_reasons": {
                  "items": {
                    "properties": {
                      "text": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "positive": {
                        "description": "False for a reason the job fits less well.",
                        "type": "boolean"
                      }
                    },
                    "type": "object",
                    "required": [
                      "text",
                      "positive"
                    ]
                  },
                  "type": "array"
                },
                "open_in_tolta": {
                  "description": "The job's page in Tolta, the only link to give the member.",
                  "type": "string"
                }
              },
              "type": "object",
              "required": [
                "match_id",
                "job_id",
                "title",
                "company",
                "location",
                "remote",
                "seniority",
                "salary",
                "posted_on",
                "fit_score",
                "fit_reasons",
                "open_in_tolta"
              ]
            },
            "type": "array"
          }
        },
        "type": "object",
        "required": [
          "matches"
        ]
      }
